<?xml version="1.0" encoding="UTF-8"?>
<xml xmlns="http://www.w3.org/1999/xhtml" collection="false">
  <variables>
    <variable type="" id="initial_amt_rf">Initial Amount</variable>
    <variable type="" id="trade_allowed_rf">Trade Allowed</variable>
    <variable type="" id="consecutive_losses_rf">Consecutive Losses</variable>
    <variable type="" id="last_tick_rf">Last Tick</variable>
    <variable type="" id="tick_history_rf">Tick History</variable>
    <variable type="" id="rise_count_rf">Rise Count</variable>
    <variable type="" id="fall_count_rf">Fall Count</variable>
    <variable type="" id="last_signal_rf">Last Signal</variable>
  </variables>

  <block type="trade" id="trade_rise_fall" x="-860" y="-260">
    <field name="MARKET_LIST">synthetic_index</field>
    <field name="SUBMARKET_LIST">random_index</field>
    <field name="SYMBOL_LIST">R_100</field>
    <field name="TRADETYPECAT_LIST">callput</field>
    <field name="TRADETYPE_LIST">risefall</field>
    <field name="TYPE_LIST">both</field>
    <field name="CANDLEINTERVAL_LIST">60</field>
    <field name="TIME_MACHINE_ENABLED">FALSE</field>
    <field name="RESTARTONERROR">TRUE</field>

    <statement name="INITIALIZATION">
      <block type="text_print" id="bot_title_rf">
        <value name="TEXT">
          <shadow type="text" id="title_shadow_rf">
            <field name="TEXT">Rise/Fall 3 Tick Filter</field>
          </shadow>
        </value>
        <next>
          <block type="variables_set" id="set_initial_amt_rf">
            <field name="VAR" id="initial_amt_rf" variabletype="">Initial Amount</field>
            <value name="VALUE">
              <block type="math_number" id="initial_amt_number_rf">
                <field name="NUM">0.35</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="set_trade_allowed_rf">
                <field name="VAR" id="trade_allowed_rf" variabletype="">Trade Allowed</field>
                <value name="VALUE">
                  <block type="logic_boolean" id="trade_allowed_true_rf">
                    <field name="BOOL">TRUE</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="set_losses_rf">
                    <field name="VAR" id="consecutive_losses_rf" variabletype="">Consecutive Losses</field>
                    <value name="VALUE">
                      <block type="math_number" id="loss_zero_rf">
                        <field name="NUM">0</field>
                      </block>
                    </value>
                    <next>
                      <block type="variables_set" id="set_last_tick_rf">
                        <field name="VAR" id="last_tick_rf" variabletype="">Last Tick</field>
                        <value name="VALUE">
                          <block type="math_number" id="last_tick_zero_rf">
                            <field name="NUM">0</field>
                          </block>
                        </value>
                        <next>
                          <block type="variables_set" id="set_rise_count_rf">
                            <field name="VAR" id="rise_count_rf" variabletype="">Rise Count</field>
                            <value name="VALUE">
                              <block type="math_number" id="rise_count_zero_rf">
                                <field name="NUM">0</field>
                              </block>
                            </value>
                            <next>
                              <block type="variables_set" id="set_fall_count_rf">
                                <field name="VAR" id="fall_count_rf" variabletype="">Fall Count</field>
                                <value name="VALUE">
                                  <block type="math_number" id="fall_count_zero_rf">
                                    <field name="NUM">0</field>
                                  </block>
                                </value>
                                <next>
                                  <block type="variables_set" id="set_last_signal_rf">
                                    <field name="VAR" id="last_signal_rf" variabletype="">Last Signal</field>
                                    <value name="VALUE">
                                      <block type="text" id="last_signal_text_rf">
                                        <field name="TEXT">NONE</field>
                                      </block>
                                    </value>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>

    <statement name="SUBMARKET">
      <block type="tradeOptions" id="trade_options_rf">
        <field name="DURATIONTYPE_LIST">t</field>
        <field name="CURRENCY_LIST">USD</field>
        <field name="BARRIEROFFSETTYPE_LIST">+</field>
        <field name="SECONDBARRIEROFFSETTYPE_LIST">-</field>
        <value name="DURATION">
          <block type="math_number" id="duration_rf">
            <field name="NUM">1</field>
          </block>
        </value>
        <value name="AMOUNT">
          <block type="variables_get" id="amount_var_rf">
            <field name="VAR" id="initial_amt_rf" variabletype="">Initial Amount</field>
          </block>
        </value>
        <value name="PREDICTION">
          <shadow type="math_number" id="prediction_shadow_rf">
            <field name="NUM">4</field>
          </shadow>
        </value>
      </block>
    </statement>
  </block>

  <block type="before_purchase" id="before_purchase_rf" collapsed="true" x="-850" y="360">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="controls_if" id="if_two_losses_stop_rf">
        <value name="IF0">
          <block type="logic_compare" id="loss_count_ge_2_rf">
            <field name="OP">GTE</field>
            <value name="A">
              <block type="variables_get" id="loss_count_var_rf">
                <field name="VAR" id="consecutive_losses_rf" variabletype="">Consecutive Losses</field>
              </block>
            </value>
            <value name="B">
              <block type="math_number" id="two_losses_limit_rf">
                <field name="NUM">2</field>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="variables_set" id="stop_trade_rf">
            <field name="VAR" id="trade_allowed_rf" variabletype="">Trade Allowed</field>
            <value name="VALUE">
              <block type="logic_boolean" id="stop_false_rf">
                <field name="BOOL">FALSE</field>
              </block>
            </value>
            <next>
              <block type="text_print" id="stop_notice_rf">
                <value name="TEXT">
                  <shadow type="text" id="stop_notice_text_rf">
                    <field name="TEXT">2 losses reached. Waiting for a fresh rise/fall sequence.</field>
                  </shadow>
                </value>
              </block>
            </next>
          </block>
        </statement>
        <next>
          <block type="controls_if" id="if_trade_allowed_rf">
            <value name="IF0">
              <block type="logic_compare" id="trade_allowed_true_rf_check">
                <field name="OP">EQ</field>
                <value name="A">
                  <block type="variables_get" id="trade_allowed_var_rf_check">
                    <field name="VAR" id="trade_allowed_rf" variabletype="">Trade Allowed</field>
                  </block>
                </value>
                <value name="B">
                  <block type="logic_boolean" id="true_check_rf">
                    <field name="BOOL">TRUE</field>
                  </block>
                </value>
              </block>
            </value>
            <statement name="DO0">
              <block type="controls_if" id="if_fall_three_rf">
                <value name="IF0">
                  <block type="logic_compare" id="fall_count_gate_rf">
                    <field name="OP">GTE</field>
                    <value name="A">
                      <block type="variables_get" id="fall_count_var_rf">
                        <field name="VAR" id="fall_count_rf" variabletype="">Fall Count</field>
                      </block>
                    </value>
                    <value name="B">
                      <block type="math_number" id="three_fall_rf">
                        <field name="NUM">3</field>
                      </block>
                    </value>
                  </block>
                </value>
                <statement name="DO0">
                  <block type="variables_set" id="set_signal_rise_rf">
                    <field name="VAR" id="last_signal_rf" variabletype="">Last Signal</field>
                    <value name="VALUE">
                      <block type="text" id="signal_rise_text_rf">
                        <field name="TEXT">RISE</field>
                      </block>
                    </value>
                    <next>
                      <block type="purchase" id="buy_rise_rf">
                        <field name="PURCHASE_LIST">CALL</field>
                      </block>
                    </next>
                  </block>
                </statement>
                <next>
                  <block type="controls_if" id="if_rise_three_rf">
                    <value name="IF0">
                      <block type="logic_compare" id="rise_count_gate_rf">
                        <field name="OP">GTE</field>
                        <value name="A">
                          <block type="variables_get" id="rise_count_var_rf">
                            <field name="VAR" id="rise_count_rf" variabletype="">Rise Count</field>
                          </block>
                        </value>
                        <value name="B">
                          <block type="math_number" id="three_rise_rf">
                            <field name="NUM">3</field>
                          </block>
                        </value>
                      </block>
                    </value>
                    <statement name="DO0">
                      <block type="variables_set" id="set_signal_fall_rf">
                        <field name="VAR" id="last_signal_rf" variabletype="">Last Signal</field>
                        <value name="VALUE">
                          <block type="text" id="signal_fall_text_rf">
                            <field name="TEXT">FALL</field>
                          </block>
                        </value>
                        <next>
                          <block type="purchase" id="buy_fall_rf">
                            <field name="PURCHASE_LIST">PUT</field>
                          </block>
                        </next>
                      </block>
                    </statement>
                  </block>
                </next>
              </block>
            </statement>
          </block>
        </next>
      </block>
    </statement>
  </block>

  <block type="after_purchase" id="after_purchase_rf" collapsed="true" x="-850" y="530">
    <statement name="AFTERPURCHASE_STACK">
      <block type="controls_if" id="check_result_loss_rf">
        <value name="IF0">
          <block type="contract_check_result" id="loss_condition_rf">
            <field name="CHECK_RESULT">loss</field>
          </block>
        </value>
        <statement name="DO0">
          <block type="math_change" id="increment_losses_rf">
            <field name="VAR" id="consecutive_losses_rf" variabletype="">Consecutive Losses</field>
            <value name="DELTA">
              <block type="math_number" id="loss_delta_rf">
                <field name="NUM">1</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="disable_trade_rf">
                <field name="VAR" id="trade_allowed_rf" variabletype="">Trade Allowed</field>
                <value name="VALUE">
                  <block type="logic_boolean" id="trade_allowed_false_rf">
                    <field name="BOOL">FALSE</field>
                  </block>
                </value>
              </block>
            </next>
          </block>
        </statement>
        <next>
          <block type="controls_if" id="check_result_win_rf">
            <value name="IF0">
              <block type="contract_check_result" id="win_condition_rf">
                <field name="CHECK_RESULT">win</field>
              </block>
            </value>
            <statement name="DO0">
              <block type="variables_set" id="reset_losses_rf">
                <field name="VAR" id="consecutive_losses_rf" variabletype="">Consecutive Losses</field>
                <value name="VALUE">
                  <block type="math_number" id="loss_reset_zero_rf">
                    <field name="NUM">0</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="reallow_trade_rf">
                    <field name="VAR" id="trade_allowed_rf" variabletype="">Trade Allowed</field>
                    <value name="VALUE">
                      <block type="logic_boolean" id="trade_allowed_true_after_win_rf">
                        <field name="BOOL">TRUE</field>
                      </block>
                    </value>
                  </block>
                </next>
              </block>
            </statement>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>

