<?xml version="1.0" encoding="UTF-8"?>
<xml xmlns="http://www.w3.org/1999/xhtml" collection="false">
  <variables>
    <variable type="" id="initial_amt_eo">Initial Amount</variable>
    <variable type="" id="trade_allowed_eo">Trade Allowed</variable>
    <variable type="" id="consecutive_losses_eo">Consecutive Losses</variable>
    <variable type="" id="last_digit_eo">Last Digit</variable>
    <variable type="" id="tick_history_eo">Tick History</variable>
    <variable type="" id="digit_history_eo">Digit History</variable>
    <variable type="" id="even_count_eo">Even Count</variable>
    <variable type="" id="odd_count_eo">Odd Count</variable>
    <variable type="" id="last_signal_eo">Last Signal</variable>
  </variables>

  <block type="trade" id="trade_even_odd" x="-860" y="-260">
    <field name="MARKET_LIST">synthetic_index</field>
    <field name="SUBMARKET_LIST">random_index</field>
    <field name="SYMBOL_LIST">R_100</field>
    <field name="TRADETYPECAT_LIST">digits</field>
    <field name="TRADETYPE_LIST">evenodd</field>
    <field name="TYPE_LIST">both</field>
    <field name="CANDLEINTERVAL_LIST">60</field>
    <field name="TIME_MACHINE_ENABLED">FALSE</field>
    <field name="RESTARTONERROR">TRUE</field>

    <statement name="INITIALIZATION">
      <block type="text_print" id="bot_title_eo">
        <value name="TEXT">
          <shadow type="text" id="title_shadow_eo">
            <field name="TEXT">Even/Odd 3 Tick Filter</field>
          </shadow>
        </value>
        <next>
          <block type="variables_set" id="set_initial_amt_eo">
            <field name="VAR" id="initial_amt_eo" variabletype="">Initial Amount</field>
            <value name="VALUE">
              <block type="math_number" id="initial_amt_number_eo">
                <field name="NUM">0.35</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="set_trade_allowed_eo">
                <field name="VAR" id="trade_allowed_eo" variabletype="">Trade Allowed</field>
                <value name="VALUE">
                  <block type="logic_boolean" id="trade_allowed_true_eo">
                    <field name="BOOL">TRUE</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="set_losses_eo">
                    <field name="VAR" id="consecutive_losses_eo" variabletype="">Consecutive Losses</field>
                    <value name="VALUE">
                      <block type="math_number" id="loss_zero_eo">
                        <field name="NUM">0</field>
                      </block>
                    </value>
                    <next>
                      <block type="variables_set" id="set_last_digit_eo">
                        <field name="VAR" id="last_digit_eo" variabletype="">Last Digit</field>
                        <value name="VALUE">
                          <block type="math_number" id="last_digit_zero_eo">
                            <field name="NUM">0</field>
                          </block>
                        </value>
                        <next>
                          <block type="variables_set" id="set_even_count_eo">
                            <field name="VAR" id="even_count_eo" variabletype="">Even Count</field>
                            <value name="VALUE">
                              <block type="math_number" id="even_count_zero_eo">
                                <field name="NUM">0</field>
                              </block>
                            </value>
                            <next>
                              <block type="variables_set" id="set_odd_count_eo">
                                <field name="VAR" id="odd_count_eo" variabletype="">Odd Count</field>
                                <value name="VALUE">
                                  <block type="math_number" id="odd_count_zero_eo">
                                    <field name="NUM">0</field>
                                  </block>
                                </value>
                                <next>
                                  <block type="variables_set" id="set_last_signal_eo">
                                    <field name="VAR" id="last_signal_eo" variabletype="">Last Signal</field>
                                    <value name="VALUE">
                                      <block type="text" id="last_signal_text_eo">
                                        <field name="TEXT">NONE</field>
                                      </block>
                                    </value>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>

    <statement name="SUBMARKET">
      <block type="tradeOptions" id="trade_options_eo">
        <field name="DURATIONTYPE_LIST">t</field>
        <field name="CURRENCY_LIST">USD</field>
        <field name="BARRIEROFFSETTYPE_LIST">+</field>
        <field name="SECONDBARRIEROFFSETTYPE_LIST">-</field>
        <value name="DURATION">
          <block type="math_number" id="duration_eo">
            <field name="NUM">1</field>
          </block>
        </value>
        <value name="AMOUNT">
          <block type="variables_get" id="amount_var_eo">
            <field name="VAR" id="initial_amt_eo" variabletype="">Initial Amount</field>
          </block>
        </value>
        <value name="PREDICTION">
          <shadow type="math_number" id="prediction_shadow_eo">
            <field name="NUM">4</field>
          </shadow>
        </value>
      </block>
    </statement>
  </block>

  <block type="before_purchase" id="before_purchase_eo" collapsed="true" x="-850" y="360">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="controls_if" id="if_two_losses_stop_eo">
        <value name="IF0">
          <block type="logic_compare" id="loss_count_ge_2_eo">
            <field name="OP">GTE</field>
            <value name="A">
              <block type="variables_get" id="loss_count_var_eo">
                <field name="VAR" id="consecutive_losses_eo" variabletype="">Consecutive Losses</field>
              </block>
            </value>
            <value name="B">
              <block type="math_number" id="two_losses_limit_eo">
                <field name="NUM">2</field>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="variables_set" id="stop_trade_eo">
            <field name="VAR" id="trade_allowed_eo" variabletype="">Trade Allowed</field>
            <value name="VALUE">
              <block type="logic_boolean" id="stop_false_eo">
                <field name="BOOL">FALSE</field>
              </block>
            </value>
            <next>
              <block type="text_print" id="stop_notice_eo">
                <value name="TEXT">
                  <shadow type="text" id="stop_notice_text_eo">
                    <field name="TEXT">2 losses reached. Waiting for a new even/odd sequence.</field>
                  </shadow>
                </value>
              </block>
            </next>
          </block>
        </statement>
        <next>
          <block type="controls_if" id="if_trade_allowed_eo">
            <value name="IF0">
              <block type="logic_compare" id="trade_allowed_true_eo_check">
                <field name="OP">EQ</field>
                <value name="A">
                  <block type="variables_get" id="trade_allowed_var_eo_check">
                    <field name="VAR" id="trade_allowed_eo" variabletype="">Trade Allowed</field>
                  </block>
                </value>
                <value name="B">
                  <block type="logic_boolean" id="true_check_eo">
                    <field name="BOOL">TRUE</field>
                  </block>
                </value>
              </block>
            </value>
            <statement name="DO0">
              <block type="controls_if" id="if_even_three_eo">
                <value name="IF0">
                  <block type="logic_compare" id="even_count_gate_eo">
                    <field name="OP">GTE</field>
                    <value name="A">
                      <block type="variables_get" id="even_count_var_eo">
                        <field name="VAR" id="even_count_eo" variabletype="">Even Count</field>
                      </block>
                    </value>
                    <value name="B">
                      <block type="math_number" id="three_even_eo">
                        <field name="NUM">3</field>
                      </block>
                    </value>
                  </block>
                </value>
                <statement name="DO0">
                  <block type="variables_set" id="set_signal_odd_eo">
                    <field name="VAR" id="last_signal_eo" variabletype="">Last Signal</field>
                    <value name="VALUE">
                      <block type="text" id="signal_odd_text_eo">
                        <field name="TEXT">ODD</field>
                      </block>
                    </value>
                    <next>
                      <block type="purchase" id="buy_odd_eo">
                        <field name="PURCHASE_LIST">DIGITODD</field>
                      </block>
                    </next>
                  </block>
                </statement>
                <next>
                  <block type="controls_if" id="if_odd_three_eo">
                    <value name="IF0">
                      <block type="logic_compare" id="odd_count_gate_eo">
                        <field name="OP">GTE</field>
                        <value name="A">
                          <block type="variables_get" id="odd_count_var_eo">
                            <field name="VAR" id="odd_count_eo" variabletype="">Odd Count</field>
                          </block>
                        </value>
                        <value name="B">
                          <block type="math_number" id="three_odd_eo">
                            <field name="NUM">3</field>
                          </block>
                        </value>
                      </block>
                    </value>
                    <statement name="DO0">
                      <block type="variables_set" id="set_signal_even_eo">
                        <field name="VAR" id="last_signal_eo" variabletype="">Last Signal</field>
                        <value name="VALUE">
                          <block type="text" id="signal_even_text_eo">
                            <field name="TEXT">EVEN</field>
                          </block>
                        </value>
                        <next>
                          <block type="purchase" id="buy_even_eo">
                            <field name="PURCHASE_LIST">DIGITEVEN</field>
                          </block>
                        </next>
                      </block>
                    </statement>
                  </block>
                </next>
              </block>
            </statement>
          </block>
        </next>
      </block>
    </statement>
  </block>

  <block type="after_purchase" id="after_purchase_eo" collapsed="true" x="-850" y="530">
    <statement name="AFTERPURCHASE_STACK">
      <block type="controls_if" id="check_result_loss_eo">
        <value name="IF0">
          <block type="contract_check_result" id="loss_condition_eo">
            <field name="CHECK_RESULT">loss</field>
          </block>
        </value>
        <statement name="DO0">
          <block type="math_change" id="increment_losses_eo">
            <field name="VAR" id="consecutive_losses_eo" variabletype="">Consecutive Losses</field>
            <value name="DELTA">
              <block type="math_number" id="loss_delta_eo">
                <field name="NUM">1</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="disable_trade_eo">
                <field name="VAR" id="trade_allowed_eo" variabletype="">Trade Allowed</field>
                <value name="VALUE">
                  <block type="logic_boolean" id="trade_allowed_false_eo">
                    <field name="BOOL">FALSE</field>
                  </block>
                </value>
              </block>
            </next>
          </block>
        </statement>
        <next>
          <block type="controls_if" id="check_result_win_eo">
            <value name="IF0">
              <block type="contract_check_result" id="win_condition_eo">
                <field name="CHECK_RESULT">win</field>
              </block>
            </value>
            <statement name="DO0">
              <block type="variables_set" id="reset_losses_eo">
                <field name="VAR" id="consecutive_losses_eo" variabletype="">Consecutive Losses</field>
                <value name="VALUE">
                  <block type="math_number" id="loss_reset_zero_eo">
                    <field name="NUM">0</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="reallow_trade_eo">
                    <field name="VAR" id="trade_allowed_eo" variabletype="">Trade Allowed</field>
                    <value name="VALUE">
                      <block type="logic_boolean" id="trade_allowed_true_after_win_eo">
                        <field name="BOOL">TRUE</field>
                      </block>
                    </value>
                  </block>
                </next>
              </block>
            </statement>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>

